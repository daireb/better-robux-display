{
  "manifest_version": 3,
  "name": "Better Robux Display",
  "version": "1.2",
  "description": "Allows configuration of robux display on Roblox.com, including hiding values and showing devex amounts.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["dist/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
